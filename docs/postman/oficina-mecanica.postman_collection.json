{
  "info": {
    "name": "Oficina Mecanica - Tech Challenge",
    "description": "Collection das APIs da Oficina Mecanica para a Fase 2. Use baseUrl=http://localhost:18080 para Kubernetes local ou baseUrl=http://localhost:8080 para Docker Compose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "clienteCpfCnpj",
      "value": "39053344705"
    },
    {
      "key": "veiculoId",
      "value": ""
    },
    {
      "key": "servicoId",
      "value": ""
    },
    {
      "key": "pecaInsumoId",
      "value": ""
    },
    {
      "key": "ordemServicoId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body.token || body.Token;",
                  "if (token) {",
                  "  pm.collectionVariables.set('token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Obter cliente por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Criar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('clienteId', body.id || body.Id);",
                  "pm.collectionVariables.set('clienteCpfCnpj', body.cpfCnpj || body.CpfCnpj);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"cpfCnpj\": \"39053344705\",\n  \"email\": \"cliente.postman@email.com\",\n  \"telefone\": \"11999999999\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "Atualizar cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Postman Atualizado\",\n  \"cpfCnpj\": \"{{clienteCpfCnpj}}\",\n  \"email\": \"cliente.atualizado@email.com\",\n  \"telefone\": \"11888888888\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          }
        },
        {
          "name": "Remover cliente",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
          }
        }
      ]
    },
    {
      "name": "Veiculos",
