    {
      "name": "Ordens de servico",
      "item": [
        {
          "name": "Listar OS",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordensservico"
          }
        },
        {
          "name": "Listar OS por status e data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordensservico?status=Recebida&ordenacao=maisAntigo"
          }
        },
        {
          "name": "Consultar OS por cliente",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/ordensservico/cliente/{{clienteCpfCnpj}}"
          }
        },
        {
          "name": "Obter OS por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordensservico/{{ordemServicoId}}"
          }
        },
        {
          "name": "Tempo medio de execucao",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ordensservico/tempo-medio-execucao"
          }
        },
        {
          "name": "Criar OS com cliente e veiculo existentes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('ordemServicoId', body.id || body.Id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpfCnpj\": \"{{clienteCpfCnpj}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"servicoIds\": [\n    \"{{servicoId}}\"\n  ],\n  \"pecasInsumos\": [\n    {\n      \"pecaInsumoId\": \"{{pecaInsumoId}}\",\n      \"quantidade\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/ordensservico"
          }
        },
